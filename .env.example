# Copy to .env for local development; set values for your own environment.
# Production requires SECRET_KEY and a PostgreSQL DATABASE_URL.

# development, testing, or production; empty defaults to development
FLASK_ENV=
# Set true to use isolated in-memory test configuration; leave empty otherwise
TESTING=
# Signing secret and database connection URL; keep real values out of Git
SECRET_KEY=
DATABASE_URL=

# Upload limit in bytes and comma-separated allowed file extensions
MAX_CONTENT_LENGTH=
ALLOWED_UPLOAD_EXTENSIONS=

# Storage backend and development-only private local upload directory
STORAGE_BACKEND=
LOCAL_UPLOAD_DIRECTORY=

# Proposed S3-compatible private object storage settings, if selected
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
