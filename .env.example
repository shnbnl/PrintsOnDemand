# Proposed environment variable names only. Configure values locally in Stage 1.
# Configuration loading and validation are not implemented yet.

# Application environment, signing secret, and PostgreSQL connection URL
APP_ENV=
SECRET_KEY=
DATABASE_URL=

# Upload limit in bytes and comma-separated allowed file extensions
MAX_CONTENT_LENGTH=
ALLOWED_UPLOAD_EXTENSIONS=

# Storage backend and development-only private local upload directory
STORAGE_BACKEND=
LOCAL_UPLOAD_DIRECTORY=

# Proposed S3-compatible private object storage settings, if selected
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
