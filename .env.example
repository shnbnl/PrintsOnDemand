# Copy to .env for local development; set values for your own environment.
# Production requires a random SECRET_KEY of at least 32 characters and a PostgreSQL DATABASE_URL.
# Keep FLASK_DEBUG unset or false in production.

# development, testing, or production; empty defaults to development
FLASK_ENV=
# Set true to use isolated in-memory test configuration; leave empty otherwise
TESTING=
# Signing secret and database connection URL; keep real values out of Git
SECRET_KEY=
DATABASE_URL=

# Browser-side Google Maps JavaScript API key; never commit a real key.
# Restrict it to approved website referrers and the Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
# Optional locally (DEMO_MAP_ID is used); supply your own map ID for production.
GOOGLE_MAPS_MAP_ID=

# Maximum individual upload in bytes (default: 16777216 = 16 MiB)
UPLOAD_MAX_SIZE=
# Maximum print count per file (default: 999)
UPLOAD_MAX_QUANTITY=

# Only local storage is implemented, for development/testing. Default root:
# instance/uploads, outside app/static and ignored by Git. Use a private path.
STORAGE_BACKEND=
UPLOAD_STORAGE_ROOT=

# Legacy one-time migration inputs only. Runtime payment settings are now managed by
# each assigned shop staff account at /shop/manage#payment-settings.
# Use fictional details for local testing; never put live credentials in Git.
ONLINE_PAYMENT_ENABLED=false
ONLINE_PAYMENT_INSTRUCTIONS=
ONLINE_PAYMENT_ACCOUNT_NAME=
ONLINE_PAYMENT_DESTINATION=
# Retired global QR URL; ignored by checkout.
PAYMENT_QR_IMAGE_URL=
# Optional plain-language instructions for onsite payment
ONSITE_PAYMENT_INSTRUCTIONS=

# Reserved for a future durable private object-storage adapter; not used yet
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
