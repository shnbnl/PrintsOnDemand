# Local secrets and environment files
.env
.env.*
!.env.example

# Python environments and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Private local application data and uploads (default UPLOAD_STORAGE_ROOT is instance/uploads)
instance/
uploads/
# If UPLOAD_STORAGE_ROOT is set to another path inside the repository, ignore it too.
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-*

# Test, coverage, and analysis outputs
output/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Build and packaging outputs
build/
dist/
*.egg-info/

# Runtime and temporary files
*.log
*.pid
*.pid.lock
tmp/
temp/
.cache/

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
